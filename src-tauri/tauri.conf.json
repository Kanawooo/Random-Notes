{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "随笺",
  "version": "0.1.0",
  "identifier": "com.suijian.notes",
  "build": {
    "beforeDevCommand": "pnpm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm run build",

    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "随笺",
        "label": "main",
        "width": 880,
        "height": 640,
        "minWidth": 680,
        "minHeight": 460,
        "decorations": false,
        "transparent": false,
        "resizable": true,
        "visible": false,
        "skipTaskbar": true,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' suijian-attachment: http://suijian-attachment.localhost; font-src 'self'; connect-src 'self' ipc:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser",
        "languages": ["SimpChinese", "English"],
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico"
      }
    }
  }
}
